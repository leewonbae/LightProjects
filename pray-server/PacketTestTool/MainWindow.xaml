<Window x:Class="PacketTestTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PacketTestTool" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="MainWindow" Height="537" Width="792">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <!-- 왼쪽 -->
            <ColumnDefinition Width="1.2*"/>
            <!-- 오른쪽 (결과창을 조금 더 넓게) -->
        </Grid.ColumnDefinitions>

        <!-- 왼쪽 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Server Info: 필요한 만큼만 -->
                <RowDefinition Height="Auto"/>
                <!-- Packet Selection: 필요한 만큼만 -->
                <RowDefinition Height="*"/>
                <!-- PropertyGrid: 남는 공간 전부 사용 -->
            </Grid.RowDefinitions>

            <GroupBox Header="Base Server Info" Grid.Row="0" Margin="5">
                <!-- GroupBox 안에 StackPanel을 넣습니다. (끝에 / 빼기) -->
                <StackPanel Orientation="Vertical" Margin="10,20,10,10">
                    <TextBlock Text="Server IP: " HorizontalAlignment="Left"/>
                    <TextBox x:Name="txtBaseServerIp" HorizontalAlignment="Left" Text="localhost" Width="150" Margin="20,5,0,0"/>
                    <TextBlock Text=" Port: " HorizontalAlignment="Left"/>
                    <TextBox x:Name="txtBaseServerPort" HorizontalAlignment="Left" Text="5113" Width="60" Margin="20,5,0,0"/>
                    <TextBlock Text="(모든 API는 이 주소를 기준으로 전송됩니다)" Foreground="Gray" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 2. 패킷 선택 그룹 -->
            <GroupBox Header="Packet Selection" Grid.Row="1" Margin="5">
                <!-- 마찬가지로 GroupBox 안에 넣습니다 -->
                <StackPanel Orientation="Vertical" Margin="10,20,10,10">
                    <ComboBox x:Name="cbPacketTypes" MinWidth="100"  
   SelectionChanged="cbPacketTypes_SelectionChanged">
                    </ComboBox>
                    <StackPanel Orientation="Horizontal">
                        <!-- ListBox가 너무 작으면 안 보이니 너비와 높이를 적절히 줍니다 -->
                        <xctk:PropertyGrid x:Name="pgRequest" 
                                             Margin="0,5,0,0"
                                             ShowSearchBox="False" 
                                             ShowSortOptions="False"
                                             AutoGenerateProperties="True"
                                             ShowSummary="False" Height="116" Width="106"/>
                    </StackPanel>
                    <Button x:Name="btnSendPacket" Content="Send" Click="btnSendPacket_Click" Background="#6651F900"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- 오른쪽-->
        <Grid Grid.Column="1">
            <StackPanel Grid.Column="1" Margin="10">
                <!-- 응답 결과 확인 -->
                <GroupBox Header="Response Data" Grid.Row="0" Margin="5">
                    <xctk:PropertyGrid x:Name="pgResponse" 
                                        Margin="0,5,0,0"
                                        ShowSearchBox="False" 
                                        ShowSortOptions="False"
                                        IsReadOnly="True"
                                        AutoGenerateProperties="True"
                                        ShowSummary="False"
                                        />
                </GroupBox>
            </StackPanel>
        </Grid>
    </Grid>

</Window>
