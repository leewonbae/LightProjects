{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss(zzz)}]  [{Level:u4}]  {Message} {NewLine}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "AccountConnection": "Server=192.168.0.10;Database=pray_dev_account;User ID=sa;Password=snow6AtMpt;Trust Server Certificate=true",
    "GameConnection": "Server=192.168.0.10;Database=pray_dev_game;User ID=sa;Password=snow6AtMpt;Trust Server Certificate=true",
    "DataTableConnection": "Server=192.168.0.10;Database=data_table;User ID=sa;Password=snow6AtMpt;Trust Server Certificate=true",
    "RedisDB": "192.168.0.10:6379"
  },
  "AllowedHosts": "*"
}